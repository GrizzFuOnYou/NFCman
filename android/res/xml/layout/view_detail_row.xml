<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="8dp">
    <TextView android:id="@+id/tv_label"
        android:layout_width="120dp" android:layout_height="wrap_content"
        android:textColor="@color/text_secondary" android:textSize="13sp" />
    <TextView android:id="@+id/tv_value"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:textColor="@color/text_primary" android:textSize="13sp" />
</LinearLayout>
