<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base dark theme -->
    <style name="Theme.NFCWallet" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryDark">@color/accent_cyan_dark</item>
        <item name="colorAccent">@color/accent_cyan</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="materialButtonStyle">@style/Widget.NFCWallet.Button</item>
        <item name="editTextStyle">@style/Widget.NFCWallet.EditText</item>
    </style>

    <!-- Primary accent button -->
    <style name="Widget.NFCWallet.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_cyan</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Outlined button -->
    <style name="Widget.NFCWallet.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/accent_cyan</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Danger/destructive button -->
    <style name="Widget.NFCWallet.Button.Danger" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_red</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Text input fields -->
    <style name="Widget.NFCWallet.EditText" parent="Widget.MaterialComponents.TextInputEditText">
        <item name="android:background">@color/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <!-- TextInputLayout dark style -->
    <style name="Widget.NFCWallet.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/accent_cyan</item>
        <item name="boxBackgroundColor">@color/bg_input</item>
        <item name="hintTextColor">@color/accent_cyan</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <!-- Card style -->
    <style name="Widget.NFCWallet.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPaddingLeft">16dp</item>
        <item name="contentPaddingTop">12dp</item>
        <item name="contentPaddingRight">16dp</item>
        <item name="contentPaddingBottom">12dp</item>
    </style>

    <!-- Divider -->
    <style name="Widget.NFCWallet.Divider">
        <item name="android:background">@color/divider</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- Title text -->
    <style name="Text.NFCWallet.Title">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <!-- Section header -->
    <style name="Text.NFCWallet.SectionHeader">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Status badge -->
    <style name="Text.NFCWallet.Status">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/accent_green</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- Log output monospace text -->
    <style name="Text.NFCWallet.Log">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

</resources>
